# ==============================================================================
# CS Study Hub - Environment Variables Reference (.env.example)
# ==============================================================================

# --- Supabase Database Configuration (Client-side) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Secure Admin Authentication (Server-side Only) ---
# Do NOT prefix these with VITE_ to prevent exposing them in frontend bundles!
# Set these in your Vercel Project Dashboard (Settings > Environment Variables)
# or in a local .env.local file (which is git-ignored).

# 1. Admin Username (Defaults to minasami)
ADMIN_USERNAME=minasami

# 2. Admin Password Configuration (Choose either ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
# Option A: Direct secure password (server hashes and compares in constant time)
# ADMIN_PASSWORD=YourCustomSecurePasswordHere

# Option B: Bcrypt Password Hash (e.g., generated via bcryptjs / htpasswd)
# ADMIN_PASSWORD_HASH=$2b$10$...

# 3. Session Signing Secret (Used for HMAC-SHA256 HttpOnly session cookies)
# SESSION_SECRET=your-random-32-character-secret-key-here
